# Copy this file to .env (see README step 3). Do NOT commit a real .env.
PORT=3000
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-this-access-secret-to-a-long-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-to-a-different-long-random-string
# Email is OPTIONAL. If SMTP_HOST is empty, emails are printed to the server console instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Task Manager <no-reply@taskmanager.local>"
